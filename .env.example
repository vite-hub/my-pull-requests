# github (default), gitlab, forgejo (Codeberg by default) or gitea
FORGE=github
# Only for self-hosted instances, for example https://git.example.com
FORGE_BASE_URL=
# On GitHub, create a token with no special scopes on https://github.com/settings/personal-access-tokens/new
FORGE_TOKEN=
RECAP_FROM=
RECAP_SITE_URL=http://localhost:3000
RECAP_TO=
# Signs recap image URLs. Generate one with `npx nuxt-og-image generate-secret`
NUXT_APP_SECRET=
